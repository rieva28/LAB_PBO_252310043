package Praktikum_1;

import java.util.Scanner;

public class Latihan_2 {
    public static void main(String[] args) {
        
        Scanner input = new Scanner(System.in);

        // Harga tanah per m2
        double hargaTanah = 5000000;

        // Input luas tanah
        System.out.print("Masukkan luas tanah (m2): ");
        double luas = input.nextDouble();

        // Membuat objek Tanah
        Tanah tanah = new Tanah(hargaTanah, luas);

        // Menghitung harga total
        double hargaTotal = tanah.hitungHargaTotal();

        // Menampilkan hasil
        System.out.println("Harga tanah per m2 : Rp. " + hargaTanah);
        System.out.println("Luas tanah          : " + luas + " m2");
        System.out.println("Harga total tanah   : Rp. " + hargaTotal);

        input.close();
    }
}