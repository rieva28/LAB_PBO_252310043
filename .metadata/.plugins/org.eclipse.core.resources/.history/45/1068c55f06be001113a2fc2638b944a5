package Praktikum_1;

import java.util.Scanner;

public class Latihan_2 {
    public static void main(String[] args) {
        System.out.println("Program Menghitung Harga Total Tanah");

        Tanah tanah = new Tanah();
        Scanner scanner = new Scanner(System.in);

        tanah.hargaTanah = 5000000;

        System.out.println("Harga tanah per m2: Rp. " + tanah.hargaTanah);

        System.out.println("Masukkan luas tanah (m2): ");
        tanah.luas = scanner.nextDouble();

        System.out.println("Harga total tanah: Rp. " + tanah.getHargaTotal());
    }
}